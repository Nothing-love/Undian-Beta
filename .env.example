# ================= KONFIGURASI DOORPRIZE =================
# Salin file ini menjadi .env lalu sesuaikan:
#   cp .env.example .env
# JANGAN commit file .env asli (sudah di-gitignore).

# Port server
PORT=3000

# --- Kredensial (WAJIB diganti sebelum dipakai publik) ---
# Username & password LOGIN operator (halaman /login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin2026

# Password PANEL ADMIN (halaman /adm1n — pengaturan target pemenang, khusus dev).
# Buat BERBEDA dari ADMIN_PASSWORD.
ADMIN_PANEL_PASSWORD=admin2026

# Kunci rahasia sesi — WAJIB diisi string acak & dirahasiakan.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Tunnel publik: 'none' untuk VPS dengan Nginx/domain biasa
TUNNEL_PROVIDER=none

# (Opsional) lokasi folder data. Default: <root>/data
# Isi bila ingin data di volume terpasang / instance terpisah.
# DORPRIZE_DATA_DIR=/var/lib/doorprize
